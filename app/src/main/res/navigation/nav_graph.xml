<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.aplicacionpeluquerias.fragments.SplashFragment"
        android:label="SplashFragment"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/inicioSesionFragment"/>
        <action
            android:id="@+id/action_splash_to_registro"
            app:destination="@id/registroFragment"/>
    </fragment>

    <fragment
        android:id="@+id/registroFragment"
        android:name="com.example.aplicacionpeluquerias.fragments.RegistroFragment"
        android:label="fragment_registro"
        tools:layout="@layout/fragment_registro">
        <action
            android:id="@+id/action_registro_to_login"
            app:destination="@id/inicioSesionFragment"/>
    </fragment>

    <fragment
        android:id="@+id/inicioSesionFragment"
        android:name="com.example.aplicacionpeluquerias.fragments.InicioSesionFragment"
        android:label="fragment_inicio_sesion"
        tools:layout="@layout/fragment_inicio_sesion">
        <action
            android:id="@+id/action_login_to_recuperar"
            app:destination="@id/recuperarContaseniaFragment"/>
        <action
            android:id="@+id/action_login_to_registro"
            app:destination="@id/registroFragment"/>
    </fragment>


    <fragment
        android:id="@+id/recuperarContaseniaFragment"
        android:name="com.example.aplicacionpeluquerias.fragments.RecuperarContaseniaFragment"
        android:label="fragment_recuperar_contasenia"
        tools:layout="@layout/fragment_recuperar_contasenia">
    </fragment>
</navigation>